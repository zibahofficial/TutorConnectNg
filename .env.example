# =============================================================================
# TutorConnect NG — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local development, or add these keys to
# your Vercel Project Settings → Environment Variables for deployment.

# Neon Serverless Postgres connection string (pooled connection recommended).
# Find this in your Neon dashboard → Project → Connection Details.
# Example: postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/tutorconnect?sslmode=require
DATABASE_URL=

# Secret used to sign JSON Web Tokens issued on login/signup.
# Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# Public base URL of the deployed app (used for absolute links in emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google Meet / Zoom integration keys (future enhancement)
# GOOGLE_MEET_API_KEY=
# ZOOM_API_KEY=
# ZOOM_API_SECRET=
